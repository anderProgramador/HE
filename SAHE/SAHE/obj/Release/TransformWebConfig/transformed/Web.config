  <system.web>
    <compilation targetFramework="4.7.2" />
    <!-- 10 MB en kilobytes. Sin esto rige el valor por omisión de 4 MB y un PDF
         de 6 MB se rechaza con un error de IIS que no explica nada. Debe ir
         acompañado de maxAllowedContentLength, que es el límite de IIS. -->
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" executionTimeout="300" />
    <!-- Antes de desplegar: debug="false" -->
    <!-- Off a propósito. Con customErrors activo, ASP.NET responde 302 hacia la
         página de error y el navegador termina recibiendo un 200: se pierde el
         código real y el módulo Http ya no distingue un 401 de un 500. Se deja
         que el error salga con su estado y IIS lo reemplaza más abajo, sin que
         el detalle de la excepción llegue nunca al navegador. -->
    <customErrors mode="Off" />
    <!-- Explícito, para que el tiempo de sesión sea una decisión y no el valor
         por omisión. Es el mismo que dispara el 401 y la pantalla de sesión
         terminada. -->
    <sessionState mode="InProc" timeout="20" />
  </system.web>
  <system.webServer>
    <!-- La página de error la sirve IIS conservando el código de estado.
         existingResponse="Replace" reemplaza también la pantalla amarilla de
         ASP.NET, así que la traza de la excepción no sale del servidor.
         Para depurar una excepción en el servidor, cambie temporalmente
         errorMode a "DetailedLocalOnly". El detalle igual queda en el log
         configurado en ArchivoLog. -->
    <security>
      <requestFiltering>
        <!-- 10 MB en bytes: el límite de IIS, que corre antes que el de ASP.NET -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <clear />
      <!-- El 401 NO se personaliza, a proposito. Con Windows Authentication el
           401 no es un error: es el desafio con que IIS pide las credenciales,
           y viaja con las cabeceras WWW-Authenticate. Si httpErrors lo
           reemplaza por esta pagina, el navegador nunca recibe el desafio, no
           puede completar el saludo NTLM y vuelve a pedir usuario y clave una
           y otra vez aunque se escriban bien. Con autenticacion anonima no se
           notaba porque no hay desafio que romper.

           La aplicacion tampoco lo necesita: su propio 401 -sesion vencida-
           solo lo devuelve FiltroAutenticacion a las llamadas XHR, y el
           navegador lo lee por codigo de estado, sin mirar el cuerpo. -->
      <error statusCode="403" path="/SAHE/Error?codigo=403" responseMode="ExecuteURL" />
      <error statusCode="404" path="/SAHE/Error?codigo=404" responseMode="ExecuteURL" />
      <error statusCode="500" path="/SAHE/Error?codigo=500" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
  <applicationSettings>
    <SAHE.Properties.Settings>
      <setting name="SAHE_ws_ClaveHost_AutenticaRegService" serializeAs="String">
        <value>http://10.7.12.123:80/WSClaveHost/services/AutenticaReg</value>
      </setting>
    </SAHE.Properties.Settings>
  </applicationSettings>
