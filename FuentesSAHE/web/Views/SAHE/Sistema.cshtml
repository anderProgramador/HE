<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SAHE</title>
    <link href="~/Estilos/Sistema.css?v=@ViewBag.VersionCss" rel="stylesheet" />
    <link href="~/Estilos/Grilla.css?v=@ViewBag.VersionCss" rel="stylesheet" />
</head>
<body>
    <div id="divPantPri"></div>
    <div id="divPantMan"></div>
    <div id="divPantPop"></div>
    @* El diálogo de mensajes ya no se repite en cada pantalla: vive una sola
       vez en Escritorio.cshtml como divPantMensaje y Mensaje se lo pide al
       documento padre. Así el velo cubre toda la ventana y no solo el marco. *@
    <input id="hdfRaiz" type="hidden" value="@Url.Content("~")" />
    <input id="hdfTabla" type="hidden" value='@ViewBag.Tabla' />
    <input id="hdfControles" type="hidden" value="@ViewBag.Controles" />
    <script src="~/Scripts/pako.js?v=@ViewBag.VersionJs" defer></script>
    <script src="~/Scripts/General.js?v=@ViewBag.VersionJs" defer></script>
    <script src="~/Scripts/Sistema.js?v=@ViewBag.VersionJs" defer></script>
</body>
</html>
